# ===== REMEAL environment configuration =====

# Database (Prisma). SQLite for local development; use postgresql:// in production.
DATABASE_URL=file:/home/z/my-project/db/custom.db

# Session signing secret — MUST be a long random string in production.
# Generate: openssl rand -base64 48
SESSION_SECRET=remeal-dev-secret-change-in-production

# Demo banner + labeling of seeded content. Set to "false" in production.
NEXT_PUBLIC_DEMO_MODE=true

# Optional: AI provider credentials (kept server-side; the platform runs the
# rule-based fallback automatically when credentials are unavailable).
# ZAI_API_KEY=

# Optional: email delivery provider. When absent, the in-app notification
# system still works and NO email delivery is ever reported as successful.
# EMAIL_PROVIDER_API_KEY=
# EMAIL_FROM=support@yourdomain.org
